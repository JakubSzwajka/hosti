{
  "name": "hosti",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @hosti/web",
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tools/eslint/*.test.mjs && npm run test --workspaces --if-present",
    "check": "biome ci . && npm run lint && npm run check --workspaces --if-present && npm run check:deps",
    "check:deps": "cd apps/web && depcruise --config ../../.dependency-cruiser.cjs apps packages",
    "lint:fix": "biome check --write .",
    "lint": "eslint .",
    "format": "biome format --write .",
    "token:new": "node apps/web/scripts/new-token.mjs",
    "env:check": "node apps/web/scripts/env-check.mjs",
    "compose:up": "docker compose up -d --pull always",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-codebase-ai-rules": "github:JakubSzwajka/eslint-plugin-codebase-ai-rules#012daeb0d1809f0e026b9425dddc9a42a77c3328",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
