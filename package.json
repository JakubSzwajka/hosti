{
  "name": "hosti",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @hosti/web",
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tools/playbook-checks/check-playbook.test.mjs && npm run test --workspaces --if-present",
    "check": "biome ci . && npm run check --workspaces --if-present && npm run check:playbook",
    "check:playbook": "depcruise --config .dependency-cruiser.cjs apps packages && node tools/playbook-checks/check-playbook.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "token:new": "node apps/web/scripts/new-token.mjs",
    "env:check": "node apps/web/scripts/env-check.mjs",
    "compose:up": "docker compose up -d --pull always",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "dependency-cruiser": "^18.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
