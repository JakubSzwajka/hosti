{
  "name": "hosti",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hosti/web dev",
    "build": "pnpm --filter @hosti/web build",
    "test": "node --test \"tests/**/*.test.mjs\" && node --test tools/eslint/*.test.mjs && TURBO_TELEMETRY_DISABLED=1 turbo run test",
    "pins": "node scripts/check-exact-pins.mjs",
    "check": "pnpm run pins && pnpm run env:check && biome ci . && pnpm run lint && pnpm run typecheck && pnpm run check:deps",
    "acceptance": "bash scripts/acceptance-cold-clone.sh",
    "prepare": "effect-tsgo patch && node scripts/prepare-hooks.mjs",
    "check:deps": "cd apps/web && depcruise --config ../../.dependency-cruiser.cjs apps packages",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo run typecheck",
    "lint:fix": "biome check --write .",
    "lint": "eslint .",
    "format": "biome format --write .",
    "token:new": "node apps/web/scripts/new-token.mjs",
    "env:check": "varlock load --filter=HOSTI_DATA_DIR,HOSTI_PUBLIC_URL,PORT,HOSTI_KEEP_REVISIONS,HOSTI_OWNER_PASSWORD,HOSTI_SECRET,HOSTI_PUSH_TOKEN,HOSTI_URL,HOSTI_TOKEN,XDG_CONFIG_HOME",
    "env:digest": "node apps/web/scripts/env-check.mjs",
    "vendor:agent-sources": "bash scripts/vendor-agent-sources.sh",
    "compose:up": "docker compose up -d --pull always",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@effect/tsgo": "0.45.0",
    "@swc/core": "1.16.2",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-codebase-ai-rules": "github:JakubSzwajka/eslint-plugin-codebase-ai-rules#012daeb0d1809f0e026b9425dddc9a42a77c3328",
    "lefthook": "2.1.14",
    "turbo": "2.11.2",
    "typescript": "7.0.2",
    "varlock": "1.20.0"
  },
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=12.5.1"
  },
  "packageManager": "pnpm@12.5.1"
}
