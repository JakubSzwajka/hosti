# Checked-in environment schema. Never put secret values here.
# CI has no local .env, so every setting is optional or has a default.
# @defaultRequired=false
# @defaultSensitive=true
# ---

# @type=string
# @sensitive=false
HOSTI_DATA_DIR=./data

# @type=url
# @sensitive=false
HOSTI_PUBLIC_URL=

# @type=port
# @sensitive=false
PORT=3000

# @type=number
# @sensitive=false
HOSTI_KEEP_REVISIONS=5

# The scrypt hash of the owner password: scrypt:16384:8:1:<salt>:<key>.
# Make it with `pnpm owner:hash`. HOSTI_OWNER_PASSWORD, the plain form, is no longer read.
# @type=string
# @sensitive=true
HOSTI_OWNER_PASSWORD_HASH=

# @type=string
# @sensitive=true
HOSTI_SECRET=

# @type=string
# @sensitive=true
HOSTI_PUSH_TOKEN=

# @type=url
# @sensitive=false
HOSTI_URL=

# @type=string
# @sensitive=true
HOSTI_TOKEN=

# The commit the image was built from. "Create release" sets it as a Docker build
# arg; /api/health reports its first 12 characters, or "unknown" when empty.
# @type=string
# @sensitive=false
APP_COMMIT=

# Used by the CLI to locate its user configuration directory.
# @sensitive=false
XDG_CONFIG_HOME=
