# Where bundles and the SQLite file live. ./data while developing, /data in the container.
HOSTI_DATA_DIR=./data

# The origin Hosti prints in push responses. Leave unset to use the request's own origin.
# HOSTI_PUBLIC_URL=https://hosti.example.com

# Port for `npm run dev` and the container.
PORT=3000

# A push token for curl. Mint one with `npm run token:new -- --name laptop`.
# HOSTI_PUSH_TOKEN=hosti_...

# What the CLI reads: the server to talk to and the push token to use.
# HOSTI_URL=http://127.0.0.1:3000
# HOSTI_TOKEN=hosti_...
