{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["@jakubszwajka/house-rules/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!.env",
      "!.env.local",
      "!.pi/specs",
      "!apps/web/.next",
      "!.agent_sources",
      "!data",
      "!fixtures",
      "!**/*.tsbuildinfo",
      "!**/package-lock.json"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
