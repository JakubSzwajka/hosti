{
  "name": "@hosti/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "HOSTI_DATA_DIR=${HOSTI_DATA_DIR:-../../data} next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "HOSTI_DATA_DIR=${HOSTI_DATA_DIR:-../../data} next start -p ${PORT:-3000}",
    "typecheck": "tsc -p tsconfig.json --noEmit && ../../node_modules/.bin/tsc -p tsconfig.effect.json --noEmit",
    "test": "vitest run",
    "token:new": "node scripts/new-token.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@hosti/bundles": "workspace:0.1.0",
    "@hosti/catalog": "workspace:0.1.0",
    "@hosti/identity": "workspace:0.1.0",
    "@hosti/shared": "workspace:0.1.0",
    "@hosti/serving": "workspace:0.1.0",
    "@hosti/storage": "workspace:0.1.0",
    "better-sqlite3": "12.11.1",
    "effect": "4.0.0-rc.117",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
